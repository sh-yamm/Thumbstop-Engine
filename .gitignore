# Publish only the tool itself: the package, its tests, the config and the README. Everything else in the working
# folder (input screenplays, run outputs, the answer cache, secrets, local tools and notes) stays local.
/*
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/config.yaml
!/thumbstop/
!/tests/
!/app/
!/deploy/
!/.github/
!/.streamlit/
!/data/

__pycache__/
.pytest_cache/
.cache/
